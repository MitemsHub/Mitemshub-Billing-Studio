# Copy this file to .env (or .env.local) and fill in your own values.
# Never commit real credentials - .env, .env.local and .env.* are git-ignored.

# Port the Express server listens on (defaults to 3000)
PORT=3000

# Appwrite Cloud (Console -> Overview -> API Keys / Settings)
APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="YOUR_APPWRITE_PROJECT_ID"
APPWRITE_API_KEY="YOUR_APPWRITE_SERVER_API_KEY"
APPWRITE_DATABASE_ID="mitemshub_billing"

# Signing key for session cookies. Optional: when unset it is derived from
# APPWRITE_API_KEY. Set your own in production.
SESSION_SECRET=""
